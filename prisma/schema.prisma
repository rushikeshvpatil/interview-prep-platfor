// Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewMode {
  AI
  PEER
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeedbackSource {
  AI
  PEER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Candidate profile & interview preferences
  bio                 String?
  experienceLevel     String? // BEGINNER | INTERMEDIATE | ADVANCED
  targetRole          String? // SDE | FRONTEND | BACKEND | FULL_STACK | SOFTWARE_ENGINEER | OTHER
  targetCompanies     String[]   @default([])
  primaryFocus        String? // DSA | SYSTEM_DESIGN | FULL_STACK | BEHAVIORAL | MIXED
  targetInterviewDate DateTime?
  preferredDifficulty Difficulty @default(MEDIUM)

  // Prep platform relations
  bookmarks           Bookmark[]
  progress            UserProblemProgress[]
  submissions         Submission[]
  notes               Note[]
  candidateSessions   InterviewSession[]    @relation("CandidateSessions")
  interviewerSessions InterviewSession[]    @relation("InterviewerSessions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ==========================================
// PROBLEM CATALOG MODELS
// ==========================================

model Problem {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  platform    String
  externalUrl String
  externalId  String?
  difficulty  Difficulty @default(MEDIUM)
  summary     String?
  constraints String?

  topics            ProblemTopic[]
  companies         ProblemCompany[]
  bookmarks         Bookmark[]
  progress          UserProblemProgress[]
  submissions       Submission[]
  notes             Note[]
  testCases         TestCase[]
  interviewSessions InterviewSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
  @@index([difficulty])
  @@index([title])
}

model Topic {
  id       String         @id @default(cuid())
  name     String         @unique
  slug     String         @unique
  problems ProblemTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id       String           @id @default(cuid())
  name     String           @unique
  slug     String           @unique
  problems ProblemCompany[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProblemTopic {
  problemId String
  topicId   String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([problemId, topicId])
}

model ProblemCompany {
  problemId String
  companyId String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([problemId, companyId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model UserProblemProgress {
  id            String    @id @default(cuid())
  userId        String
  problemId     String
  attempted     Boolean   @default(false)
  solved        Boolean   @default(false)
  attempts      Int       @default(0)
  solvedAt      DateTime?
  lastAttemptAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId])
}

model Submission {
  id            String  @id @default(cuid())
  userId        String
  problemId     String
  language      String
  sourceCode    String
  verdict       String
  stdout        String?
  stderr        String?
  executionTime Float?
  memory        Float?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Note {
  id        String @id @default(cuid())
  userId    String
  problemId String
  content   String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId])
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==========================================
// INTERVIEW SESSION & EXECUTION MODELS
// ==========================================

model InterviewSession {
  id              String        @id @default(cuid())
  userId          String // Candidate User ID
  interviewerId   String? // Null for AI mode, Peer User ID for Peer mode
  problemId       String? // Target problem for session
  mode            InterviewMode @default(AI)
  status          SessionStatus @default(SCHEDULED)
  stream          String        @default("DSA") // Future-proofed: DSA, BEHAVIORAL, SYSTEM_DESIGN, etc.
  durationMinutes Int           @default(45)
  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  inviteToken     String?       @unique @default(cuid())
  aiTranscript    Json?         // Structured conversation transcript [{ role, content, timestamp }]
  interviewerNotes String?      // Live private scratchpad notes for peer interviewer

  candidate   User     @relation("CandidateSessions", fields: [userId], references: [id], onDelete: Cascade)
  interviewer User?    @relation("InterviewerSessions", fields: [interviewerId], references: [id], onDelete: SetNull)
  problem     Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  submissions SessionSubmission[]
  feedback    SessionFeedback[]
  codeDraft   SessionCodeDraft?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([interviewerId])
  @@index([status])
}

model SessionSubmission {
  id              String   @id @default(cuid())
  sessionId       String
  code            String
  language        String // "python", "javascript", "typescript", "cpp", "java"
  verdict         String // "ACCEPTED", "WRONG_ANSWER", "TIME_LIMIT_EXCEEDED", etc.
  stdout          String?
  stderr          String?
  compileOutput   String?
  executionTime   Float?
  memory          Float?
  testCasesPassed Int?
  totalTestCases  Int?
  createdAt       DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model SessionFeedback {
  id             String         @id @default(cuid())
  sessionId      String
  source         FeedbackSource
  authorId       String?        // Null if AI, User ID if peer
  rubricScores   Json           // { correctness: 8, complexity: 9, codeQuality: 8, communication: 7, overall: 8 }
  notes          String         // Detailed feedback markdown & strengths/improvements
  recommendation String?        // "STRONG_HIRE" | "HIRE" | "BORDERLINE" | "NO_HIRE"
  createdAt      DateTime       @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model SessionCodeDraft {
  id        String   @id @default(cuid())
  sessionId String   @unique
  code      String
  language  String   @default("python")
  updatedAt DateTime @updatedAt

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
